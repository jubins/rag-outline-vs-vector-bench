DESIGN=outline
PREPARE=outline
# collection: the outline design searches every document, like the vector design
# document: it is told which document to read (easier, favours the outline design)
OUTLINE_SCOPE=collection
RATE=5
DURATION=5m
# Simulated step times in milliseconds
EMBED_MS=40
RERANK_MS=80
SELECT_MS=800
GENERATE_MS=600
